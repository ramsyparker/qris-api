---
import { Star, Menu, X, ArrowUpRight, Sun, Moon } from 'lucide-react';
import { GithubLight } from '@/components/ui/svgs/githubLight';
import { LinkButton } from '@/components/LinkButton';

const repository = 'ramsyparker/qris-api';
let starsLabel = 'Star';

try {
  const response = await fetch(`https://api.github.com/repos/${repository}/stargazers/count`, {
    headers: {
      accept: 'application/vnd.github+json',
      'X-GitHub-Api-Version': '2022-11-28',
    },
  });

  if (response.ok) {
    const result = (await response.json()) as { count?: number };
    if (typeof result.count === 'number') {
      starsLabel = new Intl.NumberFormat('id-ID', { notation: 'compact' }).format(result.count);
    }
  }
} catch {
  // The nav still works if GitHub is unavailable during a static build.
}

const githubUrl = `https://github.com/${repository}`;
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="site-brand-group">
      <a class="github-stars" href={githubUrl} target="_blank" rel="noreferrer" aria-label={`Lihat repository QRIS API di GitHub, ${starsLabel} stars`}>
        <GithubLight className="github-mark" aria-hidden="true" />
        <span class="github-stars-divider" aria-hidden="true"></span>
        <Star className="star-mark" aria-hidden="true" />
        <span class="github-stars-count">{starsLabel}</span>
      </a>

      <a class="brand" href="/" aria-label="QRIS API, halaman utama">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 28 28" fill="none">
            <path d="M3 3h8v8H3zM17 3h8v8h-8zM3 17h8v8H3z" fill="currentColor" />
            <path d="M5.5 5.5h3v3h-3zM19.5 5.5h3v3h-3zM5.5 19.5h3v3h-3z" fill="#F7F6F2" />
            <path d="M16 16h3v3h-3zM21 16h4v3h-4zM16 21h4v4h-4zM22 22h3v3h-3z" fill="currentColor" />
          </svg>
        </span>
        <span class="brand-name">QRIS <span>API</span></span>
      </a>
    </div>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Aktifkan mode gelap" title="Aktifkan mode gelap">
      <Sun className="theme-icon theme-icon-sun" aria-hidden="true" />
      <Moon className="theme-icon theme-icon-moon" aria-hidden="true" />
    </button>

    <nav class="desktop-nav" aria-label="Navigasi utama">
      <a href="/docs/">Dokumentasi</a>
      <a href="/api-reference/">API reference <ArrowUpRight aria-hidden="true" /></a>
      <LinkButton href="/app/" variant="default" className="nav-cta">Coba playground</LinkButton>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Buka navigasi">
        <Menu className="menu-open-icon" aria-hidden="true" />
        <X className="menu-close-icon" aria-hidden="true" />
      </summary>
      <nav class="mobile-nav-panel" aria-label="Navigasi utama">
        <a href="/docs/">Dokumentasi</a>
        <a href="/api-reference/">API reference</a>
        <a href="/app/">Coba playground</a>
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const buttons = document.querySelectorAll('[data-theme-toggle]');
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const applyTheme = (choice) => {
      const resolved = choice === 'system' ? (media.matches ? 'dark' : 'light') : choice;
      root.classList.add('theme-changing');
      root.classList.toggle('dark', resolved === 'dark');
      root.classList.toggle('light', resolved === 'light');
      root.style.colorScheme = resolved;
      void root.offsetHeight;
      requestAnimationFrame(() => root.classList.remove('theme-changing'));
      buttons.forEach((button) => {
        const label = resolved === 'dark' ? 'Aktifkan mode terang' : 'Aktifkan mode gelap';
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      });
    };

    let choice = localStorage.getItem('theme') || 'system';
    applyTheme(choice);

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        choice = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        localStorage.setItem('theme', choice);
        applyTheme(choice);
      });
    });

    media.addEventListener('change', () => {
      if (choice === 'system') applyTheme('system');
    });
  })();
</script>
